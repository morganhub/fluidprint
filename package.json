{
  "name": "fluidprint",
  "private": true,
  "version": "0.1.0",
  "description": "Éditeur de mise en page local pour documents imprimés : import Claude Design, édition, export PDF/X-4 CMJN.",
  "type": "module",
  "scripts": {
    "dev": "tsx server/index.ts --dev",
    "start": "tsx server/index.ts",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "import:claude-design": "tsx scripts/import-claude-design.ts",
    "diff:import": "tsx scripts/pixel-diff.ts",
    "export": "tsx scripts/export.ts",
    "setup:print": "node scripts/setup-print.mjs",
    "test:print": "node scripts/test-print.mjs",
    "extract-pdf-images": "node scripts/run-print-python.mjs scripts/extract-pdf-images.py",
    "derive-styles": "tsx scripts/derive-styles.ts",
    "print-swatches": "tsx scripts/print-swatches.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@fastify/middie": "^9.3.4",
    "@fastify/multipart": "^10.1.2",
    "@fastify/static": "^10.1.4",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tiptap/core": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fastify": "^5.12.5",
    "immer": "^11.1.18",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.48.0",
    "lucide-static": "^1.48.0",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "puppeteer-core": "^25.12.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-moveable": "^0.56.0",
    "react-selecto": "^1.26.3",
    "sharp": "^0.35.4",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
